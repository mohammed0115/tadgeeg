# --- Auditing partials ---
#: apps/reports/services/findings_service.py:107
#: templates/reports/invoice_audit_report_v2.html:468
msgid "Document Quality"
msgstr "جودة المستند"

#: apps/reports/services/findings_service.py:119
msgid ""
"Reject invoices missing an invoice number; require vendors to resubmit."
msgstr "ارفض الفواتير التي تفتقر لرقم فاتورة؛ اطلب من المورد إعادة الإصدار."

#: apps/reports/services/findings_service.py:120
msgid "Reject invoices without a date; cannot age or report without it."
msgstr "ارفض الفواتير بلا تاريخ؛ لا يمكن احتساب عمرها أو التقرير عنها."

#: apps/reports/services/findings_service.py:121
msgid "Block any invoice with no vendor — this is a basic control failure."
msgstr "احجب أي فاتورة بدون مورد — فشل ضبط أساسي."

#: apps/reports/services/findings_service.py:122
msgid "Withhold VAT recovery until a valid TRN is provided by the vendor."
msgstr "أوقف استرداد الضريبة حتى يقدّم المورد رقماً ضريبياً صالحاً."

#: apps/reports/services/findings_service.py:123
msgid "Hold invoice; without a total amount it cannot be paid or audited."
msgstr "علّق الفاتورة؛ بلا مبلغ إجمالي لا يمكن دفعها أو تدقيقها."

#: apps/reports/services/findings_service.py:124
msgid "Set a default currency at the organization level to prevent omissions."
msgstr "حدّد عملة افتراضية على مستوى المؤسسة لمنع الإغفال."

#: apps/reports/services/findings_service.py:125
msgid ""
"Investigate any zero/negative invoices — likely data error or refund "
"mishandled."
msgstr ""
"حقّق في أي فاتورة بقيمة صفر أو سالبة — غالباً خطأ بيانات أو استرداد غير "
"معالج."

#: apps/reports/services/findings_service.py:126
msgid "Recompute subtotal from line items or reject the invoice."
msgstr "أعد احتساب المجموع الفرعي من البنود أو ارفض الفاتورة."

#: apps/reports/services/findings_service.py:127
msgid "Block payment until duplicate is reconciled with the vendor."
msgstr "احجب الدفع حتى تتم تسوية التكرار مع المورد."

#: apps/reports/services/findings_service.py:128
msgid ""
"This is an exact duplicate — verify whether it was paid before approving."
msgstr "هذه نسخة مطابقة تماماً — تحقّق إن تم دفعها قبل الاعتماد."

#: apps/reports/services/findings_service.py:129
msgid ""
"High double-payment risk — match against existing payments before release."
msgstr "مخاطرة عالية للدفع المزدوج — طابق مع المدفوعات القائمة قبل الإفراج."

#: apps/reports/services/findings_service.py:130
msgid "Same file uploaded again — quarantine and notify the uploader."
msgstr "نفس الملف رُفع مرة أخرى — اعزل الملف وأبلغ من رفعه."

#: apps/reports/services/findings_service.py:131
msgid ""
"Confirm with the vendor whether the invoice number was reused legitimately."
msgstr "تأكد من المورد ما إذا كان إعادة استخدام الرقم مشروعة."

#: apps/reports/services/findings_service.py:132
#, python-format
msgid "Correct the VAT rate to 15%% (KSA) before submitting to ZATCA."
msgstr "صحّح نسبة الضريبة إلى 15%% (السعودية) قبل تقديمها إلى ZATCA."

#: apps/reports/services/findings_service.py:133
msgid ""
"Recalculate VAT; the discrepancy will be rejected at e-invoicing submission."
msgstr "أعد احتساب الضريبة؛ سيُرفض الفارق عند تقديم الفاتورة الإلكترونية."

#: apps/reports/services/findings_service.py:134
#: apps/reports/services/findings_service.py:160
msgid "Subtotal + VAT must equal total — fix arithmetic error."
msgstr ""
"يجب أن يساوي (المجموع الفرعي + الضريبة) الإجمالي — صحّح الخطأ الحسابي."

#: apps/reports/services/findings_service.py:135
msgid "Request a valid TRN from the vendor; required for input VAT recovery."
msgstr "اطلب رقماً ضريبياً صالحاً من المورد؛ مطلوب لاسترداد ضريبة المدخلات."

#: apps/reports/services/findings_service.py:136
msgid "Re-issue the invoice with a valid ZATCA Phase 2 QR code."
msgstr "أعد إصدار الفاتورة مع رمز QR صالح وفق المرحلة الثانية لـ ZATCA."

#: apps/reports/services/findings_service.py:137
msgid ""
"Compare to vendor history and obtain documented justification before "
"approval."
msgstr "قارن بسجل المورد واحصل على مبرّر موثّق قبل الاعتماد."

#: apps/reports/services/findings_service.py:138
msgid ""
"Onboard the vendor through procurement before processing further invoices."
msgstr "أدرج المورد عبر إدارة المشتريات قبل معالجة فواتير إضافية."

#: apps/reports/services/findings_service.py:139
msgid ""
"Investigate possible split invoices (structuring) to bypass approval limits."
msgstr "حقّق في احتمال تجزئة الفواتير (Structuring) لتجاوز حدود الاعتماد."

#: apps/reports/services/findings_service.py:140
msgid "Verify the price change is supported by an updated contract or quote."
msgstr "تحقّق أن تغيير السعر مدعوم بعقد محدّث أو عرض سعر."

#: apps/reports/services/findings_service.py:141
msgid ""
"Year-end concentration may indicate cutoff manipulation — sample for review."
msgstr "تركّز نهاية السنة قد يشير لتلاعب بالقطع الزمني — أخذ عيّنة للمراجعة."

#: apps/reports/services/findings_service.py:142
msgid ""
"Reduce concentration risk by qualifying additional vendors for this "
"category."
msgstr "قلّل مخاطر التركّز بتأهيل موردين إضافيين لهذه الفئة."

#: apps/reports/services/findings_service.py:143
msgid "Assign a cost center; required for departmental budget tracking."
msgstr "حدّد مركز تكلفة؛ مطلوب لمتابعة ميزانية الإدارة."

#: apps/reports/services/findings_service.py:144
msgid "Map the invoice to a chart-of-accounts code before posting."
msgstr "اربط الفاتورة برمز محاسبي قبل ترحيلها."

#: apps/reports/services/findings_service.py:145
msgid ""
"Escalate to budget owner for approval of the overage or split into next "
"period."
msgstr ""
"صعّد إلى مالك الميزانية لاعتماد التجاوز أو نقل الجزء الزائد للفترة القادمة."

#: apps/reports/services/findings_service.py:146
msgid "Investigate the post-approval edit — possible internal control breach."
msgstr "حقّق في التعديل بعد الاعتماد — اختراق محتمل للضوابط الداخلية."

#: apps/reports/services/findings_service.py:147
msgid "Reject; every invoice must have a documented approver."
msgstr "ارفض؛ يجب أن يكون لكل فاتورة معتمد موثّق."

#: apps/reports/services/findings_service.py:148
msgid ""
"Audit trail must be reconstructed before this invoice can be relied on."
msgstr "يجب إعادة بناء سجل التدقيق قبل الاعتماد على هذه الفاتورة."

#: apps/reports/services/findings_service.py:149
msgid "Request a clearer scan from the vendor to enable accurate OCR."
msgstr "اطلب نسخة أوضح من المورد لتمكين OCR دقيق."

#: apps/reports/services/findings_service.py:150
msgid "Document appears tampered — escalate to fraud investigation."
msgstr "يبدو أن المستند تعرّض للعبث — صعّد إلى التحقيق في الاحتيال."

#: apps/reports/services/findings_service.py:151
msgid "Alteration detected — quarantine and run a forensic review."
msgstr "تم رصد تعديل — اعزل المستند وأجرِ مراجعة جنائية."

#: apps/reports/services/findings_service.py:152
msgid "ZATCA Phase 2 mandates a QR code — request a re-issued e-invoice."
msgstr ""
"تشترط المرحلة الثانية لـ ZATCA وجود رمز QR — اطلب إعادة إصدار الفاتورة "
"الإلكترونية."

#: apps/reports/services/findings_service.py:155
msgid "Reject POs missing a PO number; require resubmission."
msgstr "ارفض أوامر الشراء بلا رقم؛ اطلب إعادة الإصدار."

#: apps/reports/services/findings_service.py:156
msgid "Reject POs with missing or future-dated dates."
msgstr "ارفض أوامر الشراء بلا تاريخ أو ذات تاريخ مستقبلي."

#: apps/reports/services/findings_service.py:157
msgid "Block POs without a vendor name — basic control failure."
msgstr "احجب أي أمر شراء بلا اسم مورد — فشل ضبط أساسي."

#: apps/reports/services/findings_service.py:158
msgid "Withhold processing until a valid vendor TRN is provided."
msgstr "أوقف المعالجة حتى يقدّم المورد رقماً ضريبياً صالحاً."

#: apps/reports/services/findings_service.py:159
msgid "Recalculate VAT at 15% (KSA) before approval."
msgstr "أعد احتساب الضريبة بنسبة 15% (السعودية) قبل الاعتماد."

#: apps/reports/services/findings_service.py:161
msgid "Escalate to budget owner for over-budget approval."
msgstr "صعّد إلى مالك الميزانية لاعتماد التجاوز."

#: apps/reports/services/findings_service.py:162
msgid "Reject; every PO must have a documented approver."
msgstr "ارفض؛ يجب أن يكون لكل أمر شراء معتمد موثّق."

#: apps/reports/services/findings_service.py:163
msgid "Investigate price variance against the related invoice or contract."
msgstr "حقّق في فروق السعر مقابل الفاتورة أو العقد المرتبط."

#: apps/reports/services/findings_service.py:164
msgid "Assign a cost center; required for departmental tracking."
msgstr "حدّد مركز تكلفة؛ مطلوب للمتابعة على مستوى الإدارة."

#: apps/reports/services/findings_service.py:166
msgid ""
"Reconcile closing balance with transactions before relying on the statement."
msgstr "سَوِّ رصيد الإقفال مع المعاملات قبل الاعتماد على كشف الحساب."

#: apps/reports/services/findings_service.py:167
msgid "Investigate large unjustified transactions — possible fraud signal."
msgstr "حقّق في المعاملات الكبيرة غير المبرّرة — إشارة احتيال محتملة."

#: apps/reports/services/findings_service.py:168
msgid "Investigate duplicate transactions — possible double-posting."
msgstr "حقّق في المعاملات المكرّرة — احتمال تسجيل مزدوج."

#: apps/reports/services/findings_service.py:169
msgid "Benford's-law anomaly — sample non-conforming transactions for review."
msgstr "شذوذ في قانون بنفورد — أخذ عيّنة من المعاملات غير المطابقة للمراجعة."

#: apps/reports/services/findings_service.py:170
msgid ""
"Excessive rounded amounts may indicate fabricated data — sample for review."
msgstr "كثرة المبالغ المُدوَّرة قد تشير لبيانات مُلفّقة — أخذ عيّنة للمراجعة."

#: apps/reports/services/findings_service.py:171
msgid "Weekend transactions warrant additional approval evidence."
msgstr "معاملات نهاية الأسبوع تستوجب أدلّة اعتماد إضافية."

#: apps/reports/services/findings_service.py:172
msgid "Add a valid bank account number; required for reconciliation."
msgstr "أضِف رقم حساب بنكي صالح؛ مطلوب للتسوية."

#: apps/reports/services/findings_service.py:173
msgid "Provide explicit statement period dates."
msgstr "قدّم تواريخ فترة الكشف بوضوح."

#: apps/reports/services/findings_service.py:174
msgid "Validate the IBAN against the Saudi format."
msgstr "تحقّق من صيغة IBAN السعودية."

#: apps/reports/services/findings_service.py:176
msgid "Investigate duplicate national IDs — possible ghost employee scheme."
msgstr "حقّق في تكرار أرقام الهوية الوطنية — احتمال موظفين وهميين."

#: apps/reports/services/findings_service.py:177
msgid "Confirm employees physically with HR before next payroll cycle."
msgstr "تحقّق من الموظفين فعلياً مع الموارد البشرية قبل دورة الرواتب القادمة."

#: apps/reports/services/findings_service.py:178
msgid "Recalculate net = gross − deductions; fix the variance."
msgstr "أعد احتساب الصافي = الإجمالي − الخصومات؛ عالج الفارق."

#: apps/reports/services/findings_service.py:179
msgid "Add GOSI contributions; mandatory under Saudi labor law."
msgstr "أضِف اشتراكات التأمينات الاجتماعية؛ إلزامي وفق نظام العمل السعودي."

#: apps/reports/services/findings_service.py:180
msgid "Document business justification for raises exceeding 30%."
msgstr "وثّق المبرّر التجاري للزيادات التي تتجاوز 30%."

#: apps/reports/services/findings_service.py:181
msgid "Migrate cash payments to bank transfers per AML guidance."
msgstr ""
"حوّل المدفوعات النقدية إلى تحويلات بنكية وفق إرشادات مكافحة غسيل الأموال."

#: apps/reports/services/findings_service.py:182
msgid "State the explicit payroll period."
msgstr "حدّد فترة كشف الرواتب بوضوح."

#: apps/reports/services/findings_service.py:183
msgid "Reconcile total against the per-employee detail."
msgstr "سَوِّ الإجمالي مقابل تفاصيل كل موظف."

#: apps/reports/services/findings_service.py:184
msgid "Verify employee count matches HR master records."
msgstr "تحقّق من تطابق عدد الموظفين مع سجلات الموارد البشرية."

#: apps/reports/services/findings_service.py:186
msgid "Require a receipt for every expense line before approval."
msgstr "اشترِط إيصالاً لكل بند مصروف قبل الاعتماد."

#: apps/reports/services/findings_service.py:187
msgid "Investigate duplicate expense claims — possible reimbursement fraud."
msgstr "حقّق في المطالبات المكرّرة — احتمال احتيال في التعويض."

#: apps/reports/services/findings_service.py:188
msgid "Escalate over-policy items to the responsible manager."
msgstr "صعّد البنود المتجاوزة للسياسة إلى المدير المسؤول."

#: apps/reports/services/findings_service.py:189
msgid "Reject; every expense report needs documented approval."
msgstr "ارفض؛ يحتاج كل تقرير مصروفات إلى اعتماد موثّق."

#: apps/reports/services/findings_service.py:190
msgid "Investigate possible expense splitting to bypass approval limits."
msgstr "حقّق في احتمال تجزئة المصروفات لتجاوز حدود الاعتماد."

#: apps/reports/services/findings_service.py:191
msgid "Confirm valid expense dates before reimbursement."
msgstr "تأكّد من صحّة تواريخ المصروفات قبل التعويض."

#: apps/reports/services/findings_service.py:192
msgid "Recalculate VAT on each line."
msgstr "أعد احتساب الضريبة على كل بند."

#: apps/reports/services/findings_service.py:193
msgid "Reconcile claimed total against the line-item sum."
msgstr "سَوِّ المبلغ المطالَب به مقابل مجموع البنود."

#: apps/reports/services/findings_service.py:195
msgid "Validate the taxpayer TRN against ZATCA records."
msgstr "تحقّق من الرقم الضريبي للمكلّف عبر سجلات ZATCA."

#: apps/reports/services/findings_service.py:196
msgid "Recalculate output VAT = standard-rated sales × 15%."
msgstr "أعد احتساب ضريبة المخرجات = المبيعات الخاضعة × 15%."

#: apps/reports/services/findings_service.py:197
msgid "Investigate negative input VAT — likely data error."
msgstr "حقّق في ضريبة المدخلات السالبة — غالباً خطأ بيانات."

#: apps/reports/services/findings_service.py:198
msgid "Recalculate net VAT = output − input; fix the variance."
msgstr "أعد احتساب صافي الضريبة = المخرجات − المدخلات؛ عالج الفارق."

#: apps/reports/services/findings_service.py:199
msgid "Reconcile output VAT against invoice ledger; investigate variance."
msgstr "سَوِّ ضريبة المخرجات مقابل دفتر الفواتير؛ حقّق في الفروق."

#: apps/reports/services/findings_service.py:200
msgid "Reconcile input VAT against purchase ledger; investigate variance."
msgstr "سَوِّ ضريبة المدخلات مقابل دفتر المشتريات؛ حقّق في الفروق."

#: apps/reports/services/findings_service.py:201
msgid "File on time — late filing triggers penalties."
msgstr "قدّم الإقرار في الموعد — التأخير يستوجب غرامات."

#: apps/reports/services/findings_service.py:202
msgid "Specify the explicit VAT return period."
msgstr "حدّد فترة الإقرار الضريبي بوضوح."

#: apps/reports/services/findings_service.py:204
msgid ""
"Investigate negative book values — likely posting error or impairment "
"overshoot."
msgstr ""
"حقّق في القيم الدفترية السالبة — احتمال خطأ ترحيل أو زيادة في الانخفاض."

#: apps/reports/services/findings_service.py:205
msgid ""
"Cap accumulated depreciation at original cost; correct over-depreciation."
msgstr "حُدّ الإهلاك المتراكم بالتكلفة الأصلية؛ صحّح الإهلاك الزائد."

#: apps/reports/services/findings_service.py:206
msgid "Validate depreciation rates against the asset class policy."
msgstr "تحقّق من معدّلات الإهلاك مقابل سياسة فئة الأصول."

#: apps/reports/services/findings_service.py:207
msgid "Investigate duplicate asset IDs in the register."
msgstr "حقّق في تكرار أرقام الأصول في السجل."

#: apps/reports/services/findings_service.py:208
msgid "Assign asset IDs to all rows for traceability."
msgstr "أسنِد أرقام أصول لكل الصفوف للتتبّع."

#: apps/reports/services/findings_service.py:209
msgid "Recompute book value = cost − accumulated depreciation."
msgstr "أعد احتساب القيمة الدفترية = التكلفة − الإهلاك المتراكم."

#: apps/reports/services/findings_service.py:210
msgid "Validate useful life against the asset's class (3–50 years typical)."
msgstr "تحقّق من العمر الإنتاجي حسب فئة الأصل (3–50 سنة عادةً)."

#: apps/reports/services/findings_service.py:211
msgid "Reconcile total cost against per-asset records."
msgstr "سَوِّ إجمالي التكلفة مقابل سجلات كل أصل."

#: apps/reports/services/findings_service.py:212
msgid "Reject future-dated purchase records; possible fabrication."
msgstr "ارفض سجلات الشراء بتاريخ مستقبلي؛ احتمال تلفيق."

#: apps/reports/services/findings_service.py:214
msgid "Reject receipts missing a receipt number."
msgstr "ارفض الإيصالات بلا رقم إيصال."

#: apps/reports/services/findings_service.py:215
msgid "Reject receipts with missing or future-dated dates."
msgstr "ارفض الإيصالات بلا تاريخ أو ذات تاريخ مستقبلي."

#: apps/reports/services/findings_service.py:216
msgid "Correct the VAT rate to 15% (KSA)."
msgstr "صحّح نسبة الضريبة إلى 15% (السعودية)."

#: apps/reports/services/findings_service.py:217
msgid "Recalculate VAT amount = subtotal × 15%."
msgstr "أعد احتساب مبلغ الضريبة = المجموع الفرعي × 15%."

#: apps/reports/services/findings_service.py:218
msgid "Re-issue the receipt with a ZATCA QR code."
msgstr "أعد إصدار الإيصال برمز QR من ZATCA."

#: apps/reports/services/findings_service.py:219
msgid "QR data must match receipt fields — re-issue with a corrected QR."
msgstr "يجب أن تطابق بيانات QR حقول الإيصال — أعد الإصدار برمز QR صحيح."

#: apps/reports/services/findings_service.py:220
msgid "Investigate duplicate receipts — possible double-recording."
msgstr "حقّق في الإيصالات المكرّرة — احتمال تسجيل مزدوج."

#: apps/reports/services/findings_service.py:221
msgid "Request a valid seller TRN; required for input VAT recovery."
msgstr "اطلب رقماً ضريبياً صالحاً للبائع؛ مطلوب لاسترداد ضريبة المدخلات."

#: apps/reports/services/findings_service.py:230
