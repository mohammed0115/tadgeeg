# Local development environment for Tadgeeg / FinAI
# Copy to `.env` for local work:
#   PowerShell: Copy-Item .env.development.example .env
#   Bash:       cp .env.development.example .env

# Django
DJANGO_SECRET_KEY=replace-with-a-local-dev-secret
SECRET_KEY=replace-with-a-local-dev-secret
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000
DJANGO_SETTINGS_MODULE=finai_backend.settings
DJANGO_LOG_DIR=logs

# Local database
DB_BACKEND=sqlite
SQLITE_NAME=db_runtime.sqlite3

# Docker Compose compatibility (root `docker-compose.yml` still boots MySQL)
MYSQL_DATABASE=tadgeeg_dev
MYSQL_USER=tadgeeg_dev
MYSQL_PASSWORD=tadgeeg_dev_password
MYSQL_ROOT_PASSWORD=tadgeeg_root_password
NGINX_HOST=localhost 127.0.0.1
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Redis / Celery
USE_REDIS_CACHE=False
HEALTH_REDIS_REQUIRED=False
CELERY_TASK_ALWAYS_EAGER=True
REDIS_URL=redis://127.0.0.1:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Tadgeeg Dev <noreply@localhost>
WASSLA_EMAIL_ASYNC_ENABLED=False

# Local security settings
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PORT=False
ENABLE_SECURE_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# AI / OCR (optional for local development)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=30
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGES=ara+eng

# Uploads
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_UPLOAD_SIZE_MB=200
