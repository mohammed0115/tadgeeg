#: apps/authentication/services/email_otp.py:214
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"Your verification code is: %(otp)s\n"
"This code will expire in %(minutes)s minutes.\n"
"\n"
"If you did not request this code, you can safely ignore this message."
msgstr ""
"مرحباً %(name)s،\n"
"\n"
"رمز التحقق الخاص بك هو: %(otp)s\n"
"سينتهي هذا الرمز خلال %(minutes)s دقيقة.\n"
"\n"
"إذا لم تطلب هذا الرمز، يمكنك تجاهل هذه الرسالة."

#: apps/authentication/services/email_otp.py:224
#, python-format
msgid "Email Verification Code - %(product)s"
msgstr "رمز التحقق بالبريد الإلكتروني - %(product)s"

#: apps/authentication/services/email_otp.py:245
msgid "This email address has already been verified."
msgstr "تم التحقّق من هذا البريد الإلكتروني مسبقاً."

#: apps/authentication/services/email_otp.py:302
msgid ""
"Unable to send the verification code right now. Please try again shortly."
msgstr "تعذّر إرسال رمز التحقق الآن. يرجى المحاولة بعد قليل."

#: apps/authentication/services/email_otp.py:319
msgid "The email address has already been verified."
msgstr "تم التحقّق من هذا البريد الإلكتروني مسبقاً."

#: apps/authentication/services/email_otp.py:334
msgid ""
"You have reached the maximum resend limit. Please try again later or contact"
" support."
msgstr ""
"لقد وصلت إلى الحد الأقصى لإعادة الإرسال. يرجى المحاولة لاحقاً أو التواصل مع "
"الدعم."

#: apps/authentication/services/email_otp.py:345
#, python-format
msgid "You can resend after %(seconds)s seconds."
msgstr "يمكنك إعادة الإرسال بعد %(seconds)s ثانية."

#: apps/authentication/services/email_otp.py:379
msgid ""
"Unable to resend the verification code right now. Please try again shortly."
msgstr "تعذّر إعادة إرسال رمز التحقق الآن. يرجى المحاولة بعد قليل."

#: apps/authentication/services/email_otp.py:401
msgid "There is no active verification code. Resend the code to continue."
msgstr "لا يوجد رمز تحقق نشط. أعِد إرسال الرمز للمتابعة."

#: apps/authentication/services/email_otp.py:410
msgid "The verification code has expired. Resend a new code to continue."
