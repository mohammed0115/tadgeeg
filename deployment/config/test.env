# ============================================================
# FinAI — TEST Environment Configuration
# ============================================================
ENV_NAME="test"
ENV_LABEL="TEST"

# --- Server ---
SERVER_IP="72.62.239.220"
WEB_ROOT="/var/www/test"
SOCKET="/run/finai_test.sock"
SERVICE_NAME="finai_test"
PORT_GUNICORN_INTERNAL="8003"

# --- Domains ---
DOMAIN_MAIN="test.tadgeeg.com"
DOMAIN_WWW="www.test.tadgeeg.com"
DOMAIN_ALL="test.tadgeeg.com www.test.tadgeeg.com"

# --- Git ---
REPO_URL="https://github.com/YOUR_ORG/FinAI.git"
BRANCH="test"
PROJECT_ROOT="/var/www/test/app"
BACKEND_DIR="/var/www/test/app/backend"
VENV_DIR="/var/www/test/app/backend/venv"

# --- Nginx ---
NGINX_SITE_NAME="finai_test"
NGINX_SITE_FILE="/etc/nginx/sites-available/finai_test"
NGINX_ENABLED_FILE="/etc/nginx/sites-enabled/finai_test"
STATIC_ROOT="/var/www/test/static"
MEDIA_ROOT="/var/www/test/media"
LOG_DIR="/var/log/finai/test"

# --- Database (MySQL) ---
DB_NAME="finai_test"
DB_USER="finai_test_user"
DB_HOST="127.0.0.1"
DB_PORT="3306"

# --- Django ---
DJANGO_SETTINGS_MODULE="finai_backend.settings"
DJANGO_ENV="testing"
ALLOWED_HOSTS="test.tadgeeg.com,www.test.tadgeeg.com,72.62.239.220"
DEBUG="True"

# --- SSL ---
SSL_EMAIL="admin@tadgeeg.com"
USE_SSL="true"

# --- Gunicorn workers ---
GUNICORN_WORKERS="2"
GUNICORN_TIMEOUT="180"
GUNICORN_MAX_REQUESTS="200"

# --- Redis ---
REDIS_URL="redis://127.0.0.1:6379/2"

# --- Docker ---
DOCKER_COMPOSE_FILE="docker-compose.test.yml"
DOCKER_PROJECT_NAME="finai_test"
