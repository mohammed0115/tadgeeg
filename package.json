{
  "name": "tadgeeg-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Tadgeeg Frontend build pipeline — Tailwind + Vite + PostCSS",
  "scripts": {
    "dev":     "vite build --watch --mode development",
    "build":   "vite build",
    "preview": "vite preview",
    "lint:css": "stylelint 'static/src/css/**/*.css'",
    "lint:js":  "eslint 'static/src/js/**/*.js'"
  },
  "devDependencies": {
    "vite":             "^5.2.0",
    "tailwindcss":      "^3.4.4",
    "postcss":          "^8.4.38",
    "autoprefixer":     "^10.4.19",
    "postcss-logical":  "^7.0.1",
    "stylelint":        "^16.6.1",
    "stylelint-config-standard": "^36.0.0",
    "eslint":           "^9.4.0"
  },
  "dependencies": {
    "alpinejs":   "^3.14.0",
    "chart.js":   "^4.4.3",
    "lucide":     "^0.395.0"
  }
}
