server_tokens off;

proxy_headers_hash_max_size 1024;
proxy_headers_hash_bucket_size 128;

resolver 127.0.0.11 ipv6=off valid=30s;

# ── Default catch-all: redirect to live domain ──────────────────────────────
server {
    listen 80 default_server;
    server_name _;
    return 301 http://{{LIVE_PRIMARY_DOMAIN}}$request_uri;
}

# ── Live: {{LIVE_SERVER_NAMES}} ──────────────────────────────────────────────
server {
    listen 80;
    server_name {{LIVE_SERVER_NAMES}};

    client_max_body_size 50M;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /static/ {
        alias /vol/live/static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Partner commercial registers and certificates are private and are
    # downloaded only through a staff endpoint that checks permission per
    # request. They live on their own volume, which is NOT mounted into this
    # container — so nginx cannot serve them today.
    #
    # This block exists so that stays true. If someone later mounts the private
    # volume here, or drops a symlink under the media root, the request fails
    # CLOSED instead of publishing a third party's commercial register to
    # anyone who guesses a URL.
    location ^~ /private_media/ { return 404; }
    location ^~ /media/partner_applications/ { return 404; }
    location ^~ /media/private/ { return 404; }

    location /media/ {
        alias /vol/live/media/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    location / {
        set $upstream_live web_live;
        proxy_pass http://$upstream_live:8000;
        proxy_http_version 1.1;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 120s;
    }
}

