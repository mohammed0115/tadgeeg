# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com
SITE_URL=https://your-domain.com
DJANGO_SETTINGS_MODULE=finai_backend.settings
DJANGO_LOG_DIR=/app/logs

# Nginx / Gunicorn
NGINX_HOST=your-domain.com www.your-domain.com
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Database (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=finai_db
DB_USER=finai_user
DB_PASSWORD=change-this-db-password
DB_HOST=db
DB_PORT=3306

# MySQL container bootstrap
MYSQL_DATABASE=finai_db
MYSQL_USER=finai_user
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Optional SQLite fallback for local testing only
# SQLITE_NAME=db_runtime.sqlite3

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback/

# Redis / Celery (optional if you add Redis later)
USE_REDIS_CACHE=False
# REDIS_URL=redis://redis:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FinAI <noreply@your-domain.com>
WASSLA_EMAIL_ASYNC_ENABLED=False

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=30

# Tesseract OCR
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANGUAGES=ara+eng

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# File Upload
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_UPLOAD_SIZE_MB=200

# ZIP Security (Phase 0)
ZIP_MAX_COMPRESSION_RATIO=100
ZIP_MAX_FILE_COUNT=500
ZIP_MAX_NESTING_DEPTH=1

# OpenAI Circuit Breaker (Phase 0)
# Opens after CB_FAILURE_THRESHOLD consecutive failures; recovers after CB_RECOVERY_TIMEOUT seconds
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
CB_HALF_OPEN_CALLS=2

# Sentry (Phase 0)
# Leave empty to disable Sentry. Get DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05
# App version tag shown in Sentry releases
APP_VERSION=1.0.0

# ── S3 / Object Storage (Phase 5) ─────────────────────────────────────────────
# Set USE_S3=true to activate. When false (default), media uses local filesystem.
USE_S3=false

# AWS credentials — use IAM Role on EC2/ECS instead of keys when possible
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket in Bahrain (me-south-1) for GCC data-residency compliance
AWS_STORAGE_BUCKET_NAME=finai-documents
AWS_S3_REGION_NAME=me-south-1

# Optional: CloudFront domain for public media (avatars, logos)
# Leave empty to use s3.<region>.amazonaws.com directly
AWS_S3_CUSTOM_DOMAIN=

# Optional: override endpoint URL for local MinIO testing
# AWS_S3_ENDPOINT_URL=http://localhost:9000

# How long (seconds) pre-signed document URLs stay valid (default 1 hour)
DOCUMENT_URL_EXPIRY_SECONDS=3600

# ── Monitoring (Phase 6) ───────────────────────────────────────────────────────
# Bearer token to protect /metrics/ from public access.
# Set on both the Django app AND in prometheus.yml bearer_token field.
# Leave empty only if /metrics/ is behind a firewall or private network.
METRICS_TOKEN=change-this-metrics-bearer-token
