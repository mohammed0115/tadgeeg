DJANGO_SECRET_KEY=replace-dev-secret-key
SECRET_KEY=replace-dev-secret-key
DEBUG=False
ALLOWED_HOSTS=dev.tadgeeg.com,www.dev.tadgeeg.com
CSRF_TRUSTED_ORIGINS=https://dev.tadgeeg.com,https://www.dev.tadgeeg.com
SERVER_NAMES=dev.tadgeeg.com www.dev.tadgeeg.com
CERT_NAME=dev.tadgeeg.com
SSL_EMAIL=admin@dev.tadgeeg.com
SITE_URL=https://dev.tadgeeg.com
DJANGO_SETTINGS_MODULE=finai_backend.settings
DJANGO_LOG_DIR=/app/logs
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True
ENABLE_SECURE_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
USE_REDIS_CACHE=true
CACHE_URL=redis://redis:6379/3

DB_ENGINE=django.db.backends.mysql
DB_NAME=finai_dev
DB_USER=finai_dev_user
DB_PASSWORD=change-dev-db-password
DB_HOST=db_dev
DB_PORT=3306

MYSQL_DATABASE=finai_dev
MYSQL_USER=finai_dev_user
MYSQL_PASSWORD=change-dev-db-password
MYSQL_ROOT_PASSWORD=change-dev-root-password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dev.tadgeeg.com/auth/google/callback/

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tadgeeg AI <noreply@dev.tadgeeg.com>

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=30
MAX_UPLOAD_SIZE_MB=50

# S3 / Cloud Storage (optional — leave blank to use local filesystem)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=me-south-1
AWS_S3_CUSTOM_DOMAIN=

# ── Partner application documents (Phase 2B) ─────────────────────────────────
# Commercial registrations and certificates uploaded by third parties.
#
# This path MUST stay outside MEDIA_ROOT. nginx serves /media/ publicly; if
# this ever pointed inside that tree, a stranger's commercial register would be
# downloadable by guessing a URL. It is set explicitly here rather than left to
# the settings default so a future edit cannot drift it there unnoticed.
#
# /app/private_media is a dedicated docker volume (private_dev in
# docker-compose.yml) and is NOT mounted into the nginx container.
PARTNER_DOCS_ROOT=/app/private_media/partner_applications
PARTNER_DOC_MAX_FILE_MB=10
PARTNER_DOC_MAX_TOTAL_MB=25
PARTNER_DOC_MAX_FILES=10
PARTNER_APPLICATION_DEDUPE_MINUTES=60

# ── Anonymous-surface throttles (Phases 2B / 3B) ─────────────────────────────
# OrgRateLimitMiddleware is organization-scoped and does not cover anonymous
# callers, so these are the only limit on a stranger posting repeatedly.
THROTTLE_PARTNER_APPLICATION=20/day
THROTTLE_PUBLIC_CONTACT=50/day
THROTTLE_PRICING_CALCULATOR=600/hour
