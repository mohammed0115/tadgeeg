# ============================================================
# FinAI — LIVE Environment Configuration
# ============================================================
ENV_NAME="live"
ENV_LABEL="LIVE"

# --- Server ---
SERVER_IP="72.62.239.220"
WEB_ROOT="/var/www/live"
SOCKET="/run/finai_live.sock"
SERVICE_NAME="finai_live"
PORT_GUNICORN_INTERNAL="8001"

# --- Domains ---
DOMAIN_MAIN="tadgeeg.com"
DOMAIN_WWW="www.tadgeeg.com"
DOMAIN_ALL="tadgeeg.com www.tadgeeg.com"

# --- Git ---
REPO_URL="https://github.com/mohammed0115/tadgeeg.git"
BRANCH="master"
PROJECT_ROOT="/var/www/live"
BACKEND_DIR="/var/www/live"
VENV_DIR="/var/www/live/venv"

# --- Nginx ---
NGINX_SITE_NAME="finai_live"
NGINX_SITE_FILE="/etc/nginx/sites-available/finai_live"
NGINX_ENABLED_FILE="/etc/nginx/sites-enabled/finai_live"
STATIC_ROOT="/var/www/live/static"
MEDIA_ROOT="/var/www/live/media"
LOG_DIR="/var/log/finai/live"

# --- Database (MySQL) ---
DB_NAME="finai_live"
DB_USER="finai_live_user"
DB_HOST="127.0.0.1"
DB_PORT="3306"
# DB_PASSWORD — set in .secret.env, never committed to git

# --- Django ---
DJANGO_SETTINGS_MODULE="finai_backend.settings"
DJANGO_ENV="production"
ALLOWED_HOSTS="tadgeeg.com,www.tadgeeg.com,72.62.239.220"
DEBUG="False"

# --- SSL ---
SSL_EMAIL="admin@tadgeeg.com"
USE_SSL="true"

# --- Gunicorn workers (2× CPU + 1 rule) ---
GUNICORN_WORKERS="5"
GUNICORN_TIMEOUT="120"
GUNICORN_MAX_REQUESTS="1000"

# --- Redis ---
REDIS_URL="redis://127.0.0.1:6379/0"

# --- Docker ---
DOCKER_COMPOSE_FILE="docker-compose.live.yml"
DOCKER_PROJECT_NAME="finai_live"
