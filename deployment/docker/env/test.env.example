DJANGO_SECRET_KEY=replace-test-secret-key
SECRET_KEY=replace-test-secret-key
DEBUG=False
ALLOWED_HOSTS=test.tadgeeg.com,www.test.tadgeeg.com
CSRF_TRUSTED_ORIGINS=https://test.tadgeeg.com,https://www.test.tadgeeg.com
SERVER_NAMES=test.tadgeeg.com www.test.tadgeeg.com
CERT_NAME=test.tadgeeg.com
SSL_EMAIL=admin@test.tadgeeg.com
SITE_URL=https://test.tadgeeg.com
DJANGO_SETTINGS_MODULE=finai_backend.settings
DJANGO_LOG_DIR=/app/logs
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True
ENABLE_SECURE_PROXY_SSL_HEADER=False
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

DB_ENGINE=django.db.backends.mysql
DB_NAME=finai_test
DB_USER=finai_test_user
DB_PASSWORD=change-test-db-password
DB_HOST=db_test
DB_PORT=3306

MYSQL_DATABASE=finai_test
MYSQL_USER=finai_test_user
MYSQL_PASSWORD=change-test-db-password
MYSQL_ROOT_PASSWORD=change-test-root-password

# Shared Redis cache (rate limiter, AI memory, AI budget). Dedicated DB (5)
# avoids colliding with the Celery broker (DB 2) or live/dev caches (4/3).
USE_REDIS_CACHE=True
CACHE_URL=redis://redis:6379/5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://test.tadgeeg.com/auth/google/callback/

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tadgeeg AI <noreply@test.tadgeeg.com>

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=30
MAX_UPLOAD_SIZE_MB=50

# ==============================
# Moyasar Sandbox / Test Payments
# ==============================
# Active gateway. Code reads PAYMENT_PROVIDER (singular) — see
# finai_backend/settings_canonical.py. Sandbox vs live is determined by the
# KEY PREFIX (sk_test_ / sk_live_), not by a mode flag.
PAYMENT_PROVIDER=moyasar
# Informational only (no code consumer) — documents intent for operators.
PAYMENTS_MODE=sandbox

# Use Moyasar TEST/SANDBOX keys only (sk_test_... / pk_test_...).
# NEVER put live keys in test.env. Leave blank here — fill on the server.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

PUBLIC_BASE_URL=https://test.tadgeeg.com
MOYASAR_CALLBACK_URL=https://test.tadgeeg.com/payments/callback/moyasar/
# Webhook route is fixed in Django; kept here for operator clarity only.
MOYASAR_WEBHOOK_URL=https://test.tadgeeg.com/payments/webhooks/moyasar/

SUBSCRIPTION_REQUIRED=True
AI_ACCESS_GUARD_ENABLED=True

# ── Partner application documents (Phase 2B) ─────────────────────────────────
# Commercial registrations and certificates uploaded by third parties.
#
# This path MUST stay outside MEDIA_ROOT. nginx serves /media/ publicly; if
# this ever pointed inside that tree, a stranger's commercial register would be
# downloadable by guessing a URL. It is set explicitly here rather than left to
# the settings default so a future edit cannot drift it there unnoticed.
#
# /app/private_media is a dedicated docker volume (private_test in
# docker-compose.yml) and is NOT mounted into the nginx container.
PARTNER_DOCS_ROOT=/app/private_media/partner_applications
PARTNER_DOC_MAX_FILE_MB=10
PARTNER_DOC_MAX_TOTAL_MB=25
PARTNER_DOC_MAX_FILES=10
PARTNER_APPLICATION_DEDUPE_MINUTES=60

# ── Anonymous-surface throttles (Phases 2B / 3B) ─────────────────────────────
# OrgRateLimitMiddleware is organization-scoped and does not cover anonymous
# callers, so these are the only limit on a stranger posting repeatedly.
THROTTLE_PARTNER_APPLICATION=100/day
THROTTLE_PUBLIC_CONTACT=100/day
THROTTLE_PRICING_CALCULATOR=1000/hour
