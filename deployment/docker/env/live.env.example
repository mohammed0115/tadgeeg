DJANGO_SECRET_KEY=replace-live-secret-key
SECRET_KEY=replace-live-secret-key
DEBUG=False
ALLOWED_HOSTS=tadgeeg.com,www.tadgeeg.com
CSRF_TRUSTED_ORIGINS=https://tadgeeg.com,https://www.tadgeeg.com
SERVER_NAMES=tadgeeg.com www.tadgeeg.com
CERT_NAME=tadgeeg.com
SSL_EMAIL=admin@tadgeeg.com
SITE_URL=https://tadgeeg.com
DJANGO_SETTINGS_MODULE=finai_backend.settings
DJANGO_LOG_DIR=/app/logs
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True
ENABLE_SECURE_PROXY_SSL_HEADER=False
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

DB_ENGINE=django.db.backends.mysql
DB_NAME=finai_live
DB_USER=finai_live_user
DB_PASSWORD=change-live-db-password
DB_HOST=db_live
DB_PORT=3306

MYSQL_DATABASE=finai_live
MYSQL_USER=finai_live_user
MYSQL_PASSWORD=change-live-db-password
MYSQL_ROOT_PASSWORD=change-live-root-password

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
# REQUIRED in production: the per-org rate limiter, AI assistant memory and AI
# budget counters all use Django's cache. Without Redis the app falls back to
# per-process LocMemCache, which is NOT shared across gunicorn workers — the
# rate limiter then fails closed and returns HTTP 503 "rate_limit_unavailable".
# Use a dedicated Redis DB (4) so cache keys never collide with the Celery
# broker (DB 0) or the dev cache (DB 3).
USE_REDIS_CACHE=True
CACHE_URL=redis://redis:6379/4

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tadgeeg.com/auth/google/callback/

# ── Email (notifications & verification) ──────────────────────────────────────
# Keep every key here so live.env keeps all email settings if ever recreated.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Use an app-specific password, never the account password
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Tadgeeg AI <noreply@tadgeeg.com>
# Support email used in onboarding and system notices
WASSLA_SUPPORT_EMAIL=
# Send onboarding emails asynchronously when possible
WASSLA_EMAIL_ASYNC_ENABLED=True
# Admin email for error notifications
ADMIN_EMAIL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=30
MAX_UPLOAD_SIZE_MB=50
