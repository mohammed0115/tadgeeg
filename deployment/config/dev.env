# ============================================================
# FinAI — DEV Environment Configuration
# ============================================================
ENV_NAME="dev"
ENV_LABEL="DEV"

# --- Server ---
SERVER_IP="72.62.239.220"
WEB_ROOT="/var/www/dev"
SOCKET="/run/finai_dev.sock"
SERVICE_NAME="finai_dev"
PORT_GUNICORN_INTERNAL="8002"

# --- Domains ---
DOMAIN_MAIN="dev.tadgeeg.com"
DOMAIN_WWW="www.dev.tadgeeg.com"
DOMAIN_ALL="dev.tadgeeg.com www.dev.tadgeeg.com"

# --- Git ---
REPO_URL="https://github.com/mohammed0115/tadgeeg.git"
BRANCH="dev"
PROJECT_ROOT="/var/www/dev"
BACKEND_DIR="/var/www/dev"
VENV_DIR="/var/www/dev/venv"

# --- Nginx ---
NGINX_SITE_NAME="finai_dev"
NGINX_SITE_FILE="/etc/nginx/sites-available/finai_dev"
NGINX_ENABLED_FILE="/etc/nginx/sites-enabled/finai_dev"
STATIC_ROOT="/var/www/dev/static"
MEDIA_ROOT="/var/www/dev/media"
LOG_DIR="/var/log/finai/dev"

# --- Database (MySQL) ---
DB_NAME="finai_dev"
DB_USER="finai_dev_user"
DB_HOST="127.0.0.1"
DB_PORT="3306"

# --- Django ---
DJANGO_SETTINGS_MODULE="finai_backend.settings"
DJANGO_ENV="development"
ALLOWED_HOSTS="dev.tadgeeg.com,www.dev.tadgeeg.com,72.62.239.220"
DEBUG="True"

# --- SSL ---
SSL_EMAIL="admin@tadgeeg.com"
USE_SSL="true"

# --- Gunicorn workers ---
GUNICORN_WORKERS="3"
GUNICORN_TIMEOUT="180"
GUNICORN_MAX_REQUESTS="500"

# --- Redis ---
REDIS_URL="redis://127.0.0.1:6379/1"

# --- Docker ---
DOCKER_COMPOSE_FILE="docker-compose.dev.yml"
DOCKER_PROJECT_NAME="finai_dev"
