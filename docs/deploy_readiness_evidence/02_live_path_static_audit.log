   210	WEB_SERVICES=$(web_services_for_target "$TARGET")
   211	ALL_SERVICES=$(all_services_for_target "$TARGET")
   212
   213	# Build updated web image(s) — no cache bust needed, code is COPY'd in
   214	compose build --pull $WEB_SERVICES
   215	ok "Build complete"
   216
   217	# Start/restart all relevant services
   218	compose up -d $ALL_SERVICES
   219	ok "Containers restarted"
   220
   221	# A volume created for the FIRST time during the `up` above is root-owned and
   222	# the container is already failing on it. Fix and restart once — this is the
   223	# exact failure that took production down.
   224	sleep 5
   225	for svc in $(web_services_for_target "$TARGET"); do
   226	  if compose logs --tail=20 "$svc" 2>/dev/null | grep -q "Permission denied"; then
   227	    err "$svc cannot write to a mounted volume — fixing ownership and restarting"
   228	    compose exec -T -u root "$svc" \
   229	      sh -c 'chown -R www-data:www-data /app/private_media /app/media /app/staticfiles /app/logs' \
   230	      >/dev/null 2>&1 \
   231	      || compose run --rm -u root "$svc" \
   232	           chown -R www-data:www-data /app/private_media /app/media /app/staticfiles /app/logs \
   233	           >/dev/null 2>&1 || true
   234	    compose up -d "$svc"
   235	    ok "$svc restarted after ownership fix"
   236	  fi
   237	done
