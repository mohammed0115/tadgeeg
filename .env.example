# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com
SITE_URL=https://your-domain.com
DJANGO_SETTINGS_MODULE=finai_backend.settings
DJANGO_LOG_DIR=/app/logs

# Nginx / Gunicorn
NGINX_HOST=your-domain.com www.your-domain.com
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Database (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=finai_db
DB_USER=finai_user
DB_PASSWORD=change-this-db-password
DB_HOST=db
DB_PORT=3306

# MySQL container bootstrap
MYSQL_DATABASE=finai_db
MYSQL_USER=finai_user
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Optional SQLite fallback for local testing only
# SQLITE_NAME=db_runtime.sqlite3

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback/

# Redis / Celery (optional if you add Redis later)
USE_REDIS_CACHE=False
# REDIS_URL=redis://redis:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tadgeeg AI <noreply@your-domain.com>
WASSLA_EMAIL_ASYNC_ENABLED=False

# Sentry Error Tracking (optional)
# Get your DSN from https://sentry.io/
SENTRY_DSN=
ENVIRONMENT=production

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=30

# Tesseract OCR
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANGUAGES=ara+eng

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# File Upload
MAX_UPLOAD_SIZE_MB=50

# ─── Payments ────────────────────────────────────────────────────────────────
# Active provider is read from PAYMENT_PROVIDER ONLY — clients cannot override.
# Allowed values: moyasar | tap | telr  (leave blank to disable payments)
PAYMENT_PROVIDER=moyasar     # moyasar | tap | telr (default: moyasar)
PAYMENT_MODE=test            # test | live
# Reject webhooks for any provider other than PAYMENT_PROVIDER (recommended).
# Flip to false only during a provider switch — see apps/payments/DEPLOYMENT.md.
PAYMENT_STRICT_WEBHOOK_PROVIDER=true
# Required in non-DEBUG. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Moyasar
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_BASE_URL=https://api.moyasar.com/v1
MOYASAR_CALLBACK_URL=
MOYASAR_WEBHOOK_SECRET=

# Tap Payments
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_BASE_URL=https://api.tap.company/v2
TAP_WEBHOOK_URL=
TAP_REDIRECT_URL=
TAP_WEBHOOK_SECRET=

# Telr
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_BASE_URL=https://secure.telr.com
TELR_RETURN_AUTH_URL=
TELR_RETURN_DECLINED_URL=
TELR_RETURN_CANCELLED_URL=

# Shared customer-facing redirect URLs (used as fallbacks)
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
PAYMENT_FAILURE_URL=
