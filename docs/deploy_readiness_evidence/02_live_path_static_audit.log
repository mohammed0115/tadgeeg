     1	#!/usr/bin/env bash
     2	# ============================================================
     3	# Tadgeeg — Live Server Update Script
     4	# Usage:
     5	#   bash deployment/docker/update.sh           # update live only
     6	#   bash deployment/docker/update.sh all       # update live + dev + test
     7	#   bash deployment/docker/update.sh live      # update live only
     8	#   bash deployment/docker/update.sh dev       # update dev only
     9	#   bash deployment/docker/update.sh test      # update test only
    10	#
    11	# What it does:
    12	#   1. git pull latest code from origin/main
    13	#   2. Rebuild Docker image(s)
    14	#   3. Restart container(s) — entrypoint.sh auto-runs:
    15	#      - migrate --noinput
    16	#      - compilemessages
    17	#      - collectstatic --noinput --clear
    18	#   4. Show running containers and tail logs
    19	# ============================================================
    20	set -Eeuo pipefail
    21
    22	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    23	PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
    24	COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
    25	TARGET="${1:-live}"
    26
    27	# Branch: the second argument, else $BRANCH, else whatever is checked out, else
    28	# main. It used to default to main unconditionally, so
    29	#
    30	#     git checkout my-branch && bash update.sh dev
    31	#
    32	# fetched main and `git reset --hard origin/main` — which does not merely
    33	# ignore your branch, it MOVES the local branch ref you are standing on to
    34	# main's commit. The deploy then reported success having shipped main. That is
    35	# how this deploy silently shipped the wrong code a moment ago.
    36	#
    37	# Defaulting to the current branch makes the obvious sequence do the obvious
    38	# thing; `bash update.sh dev main` or BRANCH=main still forces main.
    39	CURRENT_BRANCH="$(git -C "$PROJECT_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
    40	[ "$CURRENT_BRANCH" = "HEAD" ] && CURRENT_BRANCH=main   # detached
    41	BRANCH="${2:-${BRANCH:-$CURRENT_BRANCH}}"
    42
    43	log() { printf '\n\033[1;34m[%s] %s\033[0m\n' "$(date '+%H:%M:%S')" "$1"; }
    44	ok()  { printf '\033[1;32m  ✓ %s\033[0m\n' "$1"; }
    45	err() { printf '\033[1;31m  ✗ %s\033[0m\n' "$1"; }
    46
    47	compose() { docker compose -f "$COMPOSE_FILE" "$@"; }
    48
    49	# Which env files a target needs. Referenced by the pre-flight checks below.
    50	envs_for_target() {
    51	  case "$1" in
    52	    live) echo "live" ;;
    53	    dev)  echo "dev" ;;
    54	    test) echo "test" ;;
    55	    all)  echo "live dev test" ;;
    56	    *)    echo "live" ;;
    57	  esac
    58	}
    59
    60	web_services_for_target() {
    61	  case "$1" in
    62	    live) echo "web_live celery_live" ;;
    63	    dev)  echo "web_dev" ;;
    64	    test) echo "web_test" ;;
    65	    all)  echo "web_live celery_live web_dev web_test" ;;
    66	    *)    err "Unknown target: $1 (live|dev|test|all)"; exit 1 ;;
    67	  esac
    68	}
    69
    70	all_services_for_target() {
    71	  case "$1" in
    72	    live) echo "redis db_live web_live celery_live nginx" ;;
    73	    dev)  echo "redis db_dev web_dev nginx" ;;
    74	    test) echo "redis db_test web_test nginx" ;;
    75	    all)  echo "redis db_live web_live celery_live db_dev web_dev db_test web_test nginx" ;;
    76	    *)    err "Unknown target: $1"; exit 1 ;;
    77	  esac
    78	}
    79
    80	echo ""
    81	echo "╔══════════════════════════════════════════════╗"
    82	echo "║       Tadgeeg Live Server Update             ║"
    83	echo "╚══════════════════════════════════════════════╝"
    84	echo "  Target  : $TARGET"
    85	echo "  Branch  : $BRANCH"
    86	echo "  Project : $PROJECT_ROOT"
    87	echo ""
    88
    89	START_TIME=$(date +%s)
    90
    91	# ── 1. Git pull ────────────────────────────────────────────────────────────────
    92	log "1/4  Pulling latest code from origin/$BRANCH ..."
    93	cd "$PROJECT_ROOT"
    94
    95	# Safety net: preserve env files across the git reset. They are gitignored
    96	# today, but git reset --hard would still wipe them if a future commit ever
    97	# accidentally tracks them. Snapshot to a temp dir and restore byte-for-byte
    98	# after the reset so secrets survive every redeploy.
    99	ENV_BACKUP_DIR="$(mktemp -d -t finai-env-backup-XXXXXX)"
   100	trap 'rm -rf "$ENV_BACKUP_DIR"' EXIT
   101	shopt -s nullglob
   102	for env_file in "$SCRIPT_DIR"/env/*.env; do
   103	  cp -p "$env_file" "$ENV_BACKUP_DIR/$(basename "$env_file")"
   104	  ok "Backed up $(basename "$env_file")"
   105	done
   106	shopt -u nullglob
   107
   108	if ! git fetch origin "$BRANCH"; then
   109	  err "Branch '$BRANCH' not found on origin."
   110	  echo "    Push it first, or pass the branch: bash update.sh $TARGET <branch>"
   111	  exit 1
   112	fi
   113
   114	# Say what is about to be discarded. `reset --hard` is silent about local
   115	# commits, and a deploy is exactly when someone discovers a hotfix only ever
   116	# existed on the server.
   117	BEHIND_BY=$(git rev-list --count "origin/$BRANCH..HEAD" 2>/dev/null || echo 0)
   118	if [ "$BEHIND_BY" -gt 0 ]; then
   119	  err "$BEHIND_BY local commit(s) on this checkout are NOT on origin/$BRANCH."
   120	  git log --oneline "origin/$BRANCH..HEAD" | sed 's/^/      /'
   121	  echo "    reset --hard would discard them. Push or stash them, then re-run."
   122	  exit 1
   123	fi
   124
   125	git reset --hard "origin/$BRANCH"
   126	COMMIT=$(git log -1 --format="%h — %s (%ar)")
   127	ok "HEAD: $COMMIT  [$BRANCH]"
   128
   129	# Restore env files in case the reset removed or modified them.
   130	for backup in "$ENV_BACKUP_DIR"/*.env; do
   131	  [ -e "$backup" ] || continue
   132	  cp -p "$backup" "$SCRIPT_DIR/env/$(basename "$backup")"
   133	  ok "Restored $(basename "$backup")"
   134	done
   135
   136	# ── 2. Ensure env files and nginx config exist ────────────────────────────────
   137	log "2/4  Preparing runtime directories and config ..."
   138	mkdir -p "$SCRIPT_DIR/nginx/generated" "$SCRIPT_DIR/certbot/www" "$SCRIPT_DIR/certbot/conf"
   139
   140	for env_name in live dev test; do
   141	  target_file="$SCRIPT_DIR/env/${env_name}.env"
   142	  example_file="$SCRIPT_DIR/env/${env_name}.env.example"
   143	  if [ ! -f "$target_file" ]; then
   144	    cp "$example_file" "$target_file"
   145	    ok "Created env file: $target_file"
   146	  fi
   147	done
   148
   149	# Always re-render from the template, in whichever mode is already in force.
   150	# This previously ran only when the generated file was missing — and it is
   151	# committed, so it never ran and template edits never reached the server.
   152	# The mode is detected, not assumed: rendering http over a live HTTPS site
   153	# would downgrade it.
   154	NGINX_MODE="http"
   155	if [ -f "$SCRIPT_DIR/nginx/generated/default.conf" ] \
   156	   && grep -q "listen 443" "$SCRIPT_DIR/nginx/generated/default.conf"; then
   157	  NGINX_MODE="https"
   158	fi
   159	bash "$SCRIPT_DIR/render_nginx_config.sh" "$NGINX_MODE"
   160	ok "Rendered nginx config from template (mode: $NGINX_MODE)"
   161
   162	# ── 2b. Guards that would otherwise fail AFTER the containers start ──────────
   163	# Everything below was learned from a real outage: a root-owned volume made
   164	# Django raise PermissionError at import, gunicorn never bound, and nginx
   165	# served 502 for an hour while the entrypoint printed "Database unavailable".
   166	log "2b/4  Pre-flight checks ..."
   167
   168	# (a) required env keys — an env file created before these phases passes the
   169	#     "file exists" check while silently missing keys, and the app then falls
   170	#     back to a default. For PARTNER_DOCS_ROOT that default is inside the
   171	#     container, on no volume, so uploads die on the next rebuild.
   172	REQUIRED_KEYS="PARTNER_DOCS_ROOT PARTNER_DOC_MAX_FILE_MB PARTNER_DOC_MAX_TOTAL_MB
   173	PARTNER_DOC_MAX_FILES PARTNER_APPLICATION_DEDUPE_MINUTES
   174	THROTTLE_PARTNER_APPLICATION THROTTLE_PUBLIC_CONTACT THROTTLE_PRICING_CALCULATOR"
   175
   176	for env_name in $(envs_for_target "$TARGET"); do
   177	  env_file="$SCRIPT_DIR/env/${env_name}.env"
   178	  for key in $REQUIRED_KEYS; do
   179	    if ! grep -qE "^[[:space:]]*${key}=" "$env_file"; then
   180	      err "Missing key '${key}' in ${env_file}"
   181	      echo "    انسخه من ${env_name}.env.example ثم أعد المحاولة."
   182	      exit 1
   183	    fi
   184	  done
   185	  docs_root="$(grep -E "^[[:space:]]*PARTNER_DOCS_ROOT=" "$env_file" | tail -1 | cut -d= -f2-)"
   186	  case "$docs_root" in
   187	    */media/*|/app/media*)
   188	      err "PARTNER_DOCS_ROOT is inside the PUBLIC media root: $docs_root"
   189	      echo "    nginx يخدم /media/ علنًا — سجل تجاري لطرف ثالث سيصبح قابلًا للتنزيل."
   190	      exit 1 ;;
   191	  esac
   192	done
   193	ok "Env keys present, PARTNER_DOCS_ROOT outside the media root"
   194
   195	# (b) volume ownership. Docker creates a NEW named volume owned by root; the
   196	#     container runs as www-data. Django creates MEDIA_ROOT and
   197	#     PARTNER_DOCS_ROOT at import, so a root-owned volume stops the app before
   198	#     it can report anything useful. Idempotent — safe on every deploy.
   199	for svc in $(web_services_for_target "$TARGET"); do
   200	  if compose ps --status running --services 2>/dev/null | grep -q "^${svc}$"; then
   201	    compose exec -T -u root "$svc" \
   202	      sh -c 'chown -R www-data:www-data /app/private_media /app/media /app/staticfiles /app/logs 2>/dev/null' \
   203	      >/dev/null 2>&1 || true
   204	  fi
   205	done
   206	ok "Volume ownership normalised (www-data)"
   207
   208	# ── 3. Build + restart ────────────────────────────────────────────────────────
